# Discord bot token (from Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Guild (server) ID
GUILD_ID=your_guild_id_here

# Voice channel ID to join and rename
CHANNEL_ID=your_voice_channel_id_here

# Timezone (IANA), e.g. Asia/Baku, Europe/Istanbul, UTC
TIMEZONE=Asia/Baku

# How often to update the channel name (ms). Discord rate-limits channel renames heavily;
# keep >= 600000 (10 min) to avoid 429s. Default 600000.
UPDATE_INTERVAL_MS=600000
